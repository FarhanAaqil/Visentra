# SQLite by default; use postgresql+asyncpg://... for Postgres.
DATABASE_URL=sqlite+aiosqlite:///./visentra.db
STORAGE_ROOT=./storage
CORS_ORIGINS=["http://localhost:5173"]
# 64 hex chars (32 byte Ed25519 seed). Leave empty to generate a key under storage/keys.
SIGNING_KEY=
ENABLE_DEMO=true
AUTO_SEED=true
# Optional ImageNet-style ONNX backbone for OOD embeddings.
EMBEDDER_ONNX=
